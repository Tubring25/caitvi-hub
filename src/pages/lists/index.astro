---
import { asc, sql } from "drizzle-orm";

import BaseLayout from "@/layouts/BaseLayout.astro";
import { curatedListItems, curatedLists } from "@/db/schema";
import { dbListToSummary } from "@/lib/list-transform";
import type { ListRelationship } from "@/types/list";

const rows = await Astro.locals.db
  .select({
    list: curatedLists,
    ficCount: sql<number>`count(${curatedListItems.ficId})`,
  })
  .from(curatedLists)
  .leftJoin(curatedListItems, sql`${curatedLists.id} = ${curatedListItems.listId}`)
  .groupBy(curatedLists.id)
  .orderBy(asc(curatedLists.sortOrder));

const lists = rows.map((row) => dbListToSummary(row.list, row.ficCount));

const visibleListIds = new Set(lists.map((list) => list.id));
const listOrder = new Map(lists.map((list,index) => [list.id, index]))

const listItems = await Astro.locals.db.select({
  listId: curatedListItems.listId,
  ficId: curatedListItems.ficId
}).from(curatedListItems)

const listsByFic = new Map<string, Set<string>>()

for(const item of listItems) {
  if(!visibleListIds.has(item.listId)) continue
  const memberships = listsByFic.get(item.ficId) ?? new Set()

  memberships.add(item.listId)
  listsByFic.set(item.ficId, memberships)
}

const relationshipCounts = new Map<string, ListRelationship>();
for(const memberships of listsByFic.values()) {
  const memberIds = Array.from(memberships).sort((a, b) => {
    return listOrder.get(a)! - listOrder.get(b)!
  })

  for (let sourceIndex = 0; sourceIndex < memberIds.length; sourceIndex += 1) {
    for (let targetIndex = sourceIndex + 1; targetIndex < memberIds.length; targetIndex += 1) {
      const sourceId = memberIds[sourceIndex]
      const targetId = memberIds[targetIndex]
      const id = `${sourceId}--${targetId}`
      const current = relationshipCounts.get(id);

      relationshipCounts.set(id, {
        id, sourceId, targetId, sharedCount: (current?.sharedCount ?? 0) + 1
      })
    }
  }
}

const relationships = Array.from(relationshipCounts.values()).sort(
  (a, b) => b.sharedCount - a.sharedCount
)

const relationshipsByList = new Map<string, ListRelationship[]>()
for(const relationship of relationships) {
  const connectedListId = [
    relationship.sourceId,
    relationship.targetId,
  ]

  for (const listId of connectedListId) {
    const relatedRelationships = relationshipsByList.get(listId) ?? []

    relatedRelationships.push(relationship)
    relationshipsByList.set(listId, relatedRelationships)
  }
}

---

<BaseLayout
  title="Favorites | Piltover's Finest"
  description="The CaitVi fan fiction I keep coming back to, grouped by mood and theme."
>
  <main class="lists-page">
    <section class="lists-hero" aria-labelledby="lists-title">
      <div class="lists-hero__frame" aria-hidden="true"></div>
      <div class="lists-hero__inner">
        <p class="lists-eyebrow">Personal shelf</p>
        <h1 id="lists-title">Favorites</h1>
        <p class="lists-hero__description">
          The stories I keep coming back to, grouped by mood.
        </p>
        <div class="lists-hero__meta" aria-label="Archive summary">
          <span>CaitVi fan fiction</span>
          <span>{lists.length} {lists.length === 1 ? "collection" : "collections"}</span>
        </div>
      </div>
    </section>

    <section class="lists-index" aria-labelledby="collections-title">
      <header class="lists-index__header">
        <h2 id="collections-title">Collections</h2>
      </header>

      {lists.length === 0 ? (
        <div class="lists-empty">
          <span aria-hidden="true"></span>
          <p>Nothing saved here yet.</p>
        </div>
      ) : (
        <div class="collection-board" data-collection-board="true">
          <svg class="collection-board__relationship-layer"
            data-relationship-layer="true"
            aria-hidden="true"
            focusable="false"
          >
            {relationships.map(relationship => (
              <g
                data-relationship-group={relationship.id}
                data-source-id={relationship.sourceId}
                data-target-id={relationship.targetId}
              >
                <path
                  class="collection-board__relationship-path"
                  data-relationship-path={relationship.id}
                />

                <text
                  class="collection-board__relationship-label"
                  data-relationship-label={relationship.id}
                  text-anchor="middle"
                  dominant-baseline="middle"
                >
                  {relationship.sharedCount} shared{" "}
                  {relationship.sharedCount === 1 ? "story" : "stories"}
                </text>
              </g>
            ))}

          </svg>
          <ol class="collections-card-list">
            {lists.map((list, index) => {
              const relatedRelationships = relationshipsByList.get(list.id) ?? []
              return (
                <li>
                  <a href={`/lists/${list.slug}`} class="collections-card" data-list-card={list.id}>
                    {relatedRelationships.map((relationship) => {
                      const peerId = relationship.sourceId === list.id ? relationship.targetId : relationship.sourceId
                      return (
                      <span class="collections-card__anchor" data-anchor={relationship.id} data-peer={peerId} aria-hidden="true"></span>
                      )
                    })}
                    <span class="collections-card__square-decoration top-right" aria-hidden="true"></span>
                    <span class="collections-card__square-decoration top-left" aria-hidden="true"></span>
                    <span class="collections-card__square-decoration bottom-right" aria-hidden="true"></span>
                    <span class="collections-card__square-decoration bottom-left" aria-hidden="true"></span>
                    <span class="collections-card__number" aria-hidden="true">
                      {String(index + 1).padStart(2, "0")}
                    </span>

                    <div class="collections-card__body">
                      <h3 class="collections-card__title">{list.title}</h3>
                      <p class="collections-card__description">{list.description}</p>
                    </div>

                    <span class="collections-card__count">
                      {list.ficCount} {list.ficCount === 1 ? "story" : "stories"}
                    </span>

                    <span class="collections-card__action">Explore collection <span aria-hidden="true">→</span></span>
                  </a>
                </li>
              )
            })}
          </ol>
        </div>
      )}
    </section>
  </main>
</BaseLayout>

<style is:global>
  body:has(.lists-page) {
    --lists-surface: oklch(0.958 0.012 145);
    --lists-ink: oklch(0.26 0.032 238);
    --lists-ink-soft: oklch(0.43 0.025 222);
    --lists-ink-muted: oklch(0.56 0.018 205);
    --lists-line: oklch(0.48 0.035 155 / 0.22);
    --lists-green: oklch(0.39 0.07 153);
    --lists-gold: oklch(0.64 0.105 79);
    --lists-blue: oklch(0.43 0.095 250);
    --lists-serif: "Iowan Old Style", "Palatino Linotype", Palatino, "Playfair Display", Georgia, serif;
    background: var(--lists-surface);
    color: var(--lists-ink);
    scrollbar-color: var(--lists-green) var(--lists-surface);
  }

  body:has(.lists-page)::-webkit-scrollbar-thumb {
    border: 2px solid var(--lists-surface);
    border-radius: 0;
    background: var(--lists-green);
  }

  body:has(.lists-page) #site-header {
    border-bottom: 1px solid var(--lists-line);
    background: var(--lists-surface);
    color: var(--lists-ink);
  }

  body:has(.lists-page) #header-accent {
    background: var(--lists-gold) !important;
    opacity: 0.62 !important;
  }

  body:has(.lists-page) #site-header.header-scrolled {
    background: var(--lists-surface) !important;
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
  }

  body:has(.lists-page) #site-header > div:last-child > a > span,
  body:has(.lists-page) #site-header nav a {
    color: var(--lists-ink-soft) !important;
    text-shadow: none;
  }

  body:has(.lists-page) #site-header nav a.nav-active {
    color: var(--lists-blue) !important;
  }

  body:has(.lists-page) #site-header .nav-active::after {
    border-radius: 0;
    background: var(--lists-gold);
    box-shadow: none;
    transform: translateX(-50%) rotate(45deg);
  }

  body:has(.lists-page) #site-header button {
    border-color: var(--lists-line) !important;
    border-radius: 0;
    background: transparent !important;
    color: var(--lists-ink-soft) !important;
  }

  body:has(.lists-page) #site-header button > span.absolute {
    display: none;
  }

  body:has(.lists-page) #site-header button span:not(.absolute) {
    color: var(--lists-ink-soft) !important;
  }

  body:has(.lists-page) footer {
    margin-top: 0;
    background: var(--lists-surface);
    color: var(--lists-ink-soft);
  }

  body:has(.lists-page) footer > div:first-child {
    background: var(--lists-line);
  }

  body:has(.lists-page) footer div,
  body:has(.lists-page) footer nav,
  body:has(.lists-page) footer a {
    color: var(--lists-ink-muted) !important;
  }

  body:has(.lists-page) footer a:hover {
    color: var(--lists-blue) !important;
  }

  .lists-page {
    min-height: 100svh;
    flex: 1;
    padding-top: 4.5rem;
    overflow: hidden;
    background: var(--lists-surface);
    color: var(--lists-ink);
    font-family: "Plus Jakarta Sans", ui-sans-serif, system-ui, sans-serif;
  }

  .lists-hero {
    position: relative;
    display: grid;
    min-height: clamp(31rem, 68svh, 44rem);
    place-items: center;
    padding: clamp(5rem, 11vw, 8rem) clamp(1.25rem, 7vw, 7rem);
  }

  .lists-hero__frame {
    position: absolute;
    inset: clamp(1.75rem, 4vw, 3.5rem) clamp(1rem, 7vw, 7rem);
    border: 1px solid var(--lists-line);
    pointer-events: none;
  }

  .lists-hero__frame::before,
  .lists-hero__frame::after {
    position: absolute;
    left: 50%;
    width: 9px;
    height: 9px;
    border: 1px solid var(--lists-gold);
    background: var(--lists-surface);
    content: "";
    transform: translateX(-50%) rotate(45deg);
  }

  .lists-hero__frame::before {
    top: -5px;
  }

  .lists-hero__frame::after {
    bottom: -5px;
  }

  .lists-hero__inner {
    position: relative;
    z-index: 1;
    display: flex;
    max-width: 46rem;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .lists-eyebrow {
    margin: 0;
    color: var(--lists-green);
    font-size: 0.68rem;
    font-weight: 750;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .lists-hero h1 {
    margin: clamp(1.25rem, 3vw, 2rem) 0 0;
    font-family: var(--lists-serif);
    font-size: clamp(3.25rem, 7vw, 5.75rem);
    font-weight: 500;
    line-height: 0.96;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .lists-hero__description {
    max-width: 34rem;
    margin: clamp(1.5rem, 3vw, 2.25rem) 0 0;
    color: var(--lists-ink-soft);
    font-family: var(--lists-serif);
    font-size: clamp(1.05rem, 1.7vw, 1.3rem);
    font-style: italic;
    line-height: 1.55;
  }

  .lists-hero__meta {
    display: flex;
    align-items: center;
    margin-top: clamp(1.75rem, 4vw, 2.75rem);
    color: var(--lists-ink-soft);
    font-size: 0.68rem;
    font-variant-numeric: tabular-nums;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .lists-hero__meta span + span::before {
    display: inline-block;
    width: 1px;
    height: 0.85rem;
    margin-inline: 1rem;
    background: var(--lists-gold);
    content: "";
    vertical-align: -0.15rem;
  }

  .lists-index {
    width: min(100% - 2.5rem, 76rem);
    margin-inline: auto;
    padding-block: clamp(3.5rem, 7vw, 6rem) clamp(5rem, 10vw, 9rem);
  }

  .lists-index__header {
    padding-bottom: 1.5rem;
  }

  .lists-index__header h2 {
    margin: 0;
    font-family: var(--lists-serif);
    font-size: clamp(2rem, 4vw, 3.25rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .lists-empty {
    display: flex;
    min-height: 18rem;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    border-bottom: 1px solid var(--lists-line);
    color: var(--lists-ink-soft);
    font-family: var(--lists-serif);
    text-align: center;
  }

  .lists-empty span {
    width: 9px;
    height: 9px;
    border: 1px solid var(--lists-gold);
    transform: rotate(45deg);
  }

  .collection-board {
    position: relative;
    isolation: isolate;
  }

  .collection-board__relationship-layer {
    position: absolute;
    z-index: 0;
    inset: 0;
    display: none;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .collections-card-list {
    position: relative;
    z-index: 1;
    display: grid;
    list-style: none;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: 1.5rem;
    column-gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .collections-card {
    --card-frame: var(--lists-green);

    display: flex;
    flex-direction: column;
    position: relative;
    min-height: 11rem;
    padding: clamp(1.25rem, 3vw, 2.25rem);
    border: 1px solid var(--card-frame);
    background: var(--lists-surface);
    color: inherit;
    text-decoration: none;
    transition: border-color 200ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .collections-card-list > li {
    min-width: 0;
  }

  .collections-card__number {
    position: absolute;
    z-index: 2;
    top: -0.5em;
    left: clamp(1.25rem, 3vw, 2.25rem);
    padding-inline: 0.5rem;
    background: var(--lists-surface);
    color: var(--lists-gold);
    font-family: var(--lists-serif);
    font-size: clamp(1.25rem, 2vw, 1.75rem);
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .collections-card__body {
    margin-top: 1rem;
  }

  .collections-card__title {
    margin: 0;
    font-size: clamp(2.4rem, 3vw, 2.75rem);
    font-weight: 500;
    line-height: 1.1;
    color: var(--lists-green);
    font-family: var(--lists-serif);
  }

  .collections-card__description {
    margin: 0.75rem 0 0;
    color: var(--lists-ink-soft);
    max-width: 46ch;
    line-height: 1.65;
  }

  .collections-card__count {
    color: var(--lists-gold);
    font-size: 0.7rem;
    font-weight: 650;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding-top: clamp(1.25rem, 3vw, 2.25rem);
  }

  .collections-card__action {
    margin-top: auto;
    padding-top: 1.5rem;
    color: var(--lists-green);
    font-family: var(--lists-serif);
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    font-weight: 500;
  }

  .collections-card__square-decoration,
  .collections-card__square-decoration::after {
    position: absolute;
    width: 17px;
    height: 17px;
    border-top: 1px solid var(--card-frame);
    border-left: 1px solid var(--card-frame);
    pointer-events: none;
    transition: border-color 200ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .collections-card__square-decoration::after {
    top: 4px;
    left: 4px;
    width: 8px;
    height: 8px;
    content: "";
  }

  .collections-card__square-decoration.top-right {
    top: 8px;
    right: 8px;
    transform: rotate(90deg);
  }

  .collections-card__square-decoration.bottom-left {
    bottom: 8px;
    left: 8px;
    transform: rotate(270deg);
  }

  .collections-card__square-decoration.bottom-right {
    bottom: 8px;
    right: 8px;
    transform: rotate(180deg);
  }

  .collections-card__square-decoration.top-left {
    top: 8px;
    left: 8px;
  }

  .collections-card__title,
  .collections-card__action {
    transition: color 200ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .collections-card__action > [aria-hidden="true"] {
    display: inline-block;
    transition: transform 200ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .collections-card:is(:hover, :focus-visible)
    .collections-card__action > [aria-hidden="true"] {
    transform: translateX(0.25rem);
  }

  .collections-card:focus-visible {
    outline: 2px solid var(--lists-blue);
    outline-offset: 3px;
  }

  .collections-card::before {
    content: "";
    position: absolute;
    inset: 5px;
    border: 1px solid var(--card-frame);
    opacity: 0.5;
    pointer-events: none;
    transition: border-color 200ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .collections-card:is(:hover, :focus-visible) {
    --card-frame: var(--lists-blue);
  }

  .collections-card:is(:hover, :focus-visible)
    :is(.collections-card__title, .collections-card__action) {
    color: var(--lists-blue);
  }

  @media (min-width: 48rem) {
    .lists-index {
      width: min(100% - 4rem, 76rem);
    }
  }

  @media (min-width: 64rem) {
    .collection-board__relationship-layer {
      display: block;
    }

    .collections-card-list {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      row-gap: 2.5rem;
      column-gap: 1.5rem;
    }

    .collections-card-list > li:nth-child(6n + 1) {
      grid-column: 1 / span 7;
      margin-top: 0;
    }

    .collections-card-list > li:nth-child(6n + 2) {
      grid-column: 9 / span 4;
      margin-top: 5rem;
    }

    .collections-card-list > li:nth-child(6n + 3) {
      grid-column: 2 / span 4;
      margin-top: 1rem;
    }
    .collections-card-list > li:nth-child(6n + 4) {
      grid-column: 7 / span 6;
      margin-top: 4rem;
    }

    .collections-card-list > li:nth-child(6n + 5) {
      grid-column: 1 / span 5;
      margin-top: 2rem;
    }

    .collections-card-list > li:nth-child(6n + 6) {
      grid-column: 8 / span 5;
      margin-top: 0;
    }
  }

  .collections-card__anchor {
    display: none;
  }

  @media (min-width: 64rem) {
    .collections-card__anchor {
      position: absolute;
      z-index: 3;
      top: 50%;
      right: 0;
      display: block;
      width: 11px;
      height: 11px;
      border: 1px solid var(--lists-gold);
      background: var(--lists-surface);
      transform: translate(50%, -50%) rotate(45deg);
      pointer-events: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .collections-card__action > [aria-hidden="true"] {
      transition: none;
    }

    .collections-card:is(:hover, :focus-visible)
      .collections-card__action > [aria-hidden="true"] {
      transform: none;
    }
  }

  @media (prefers-color-scheme: dark) {
    body:has(.lists-page) {
      --lists-surface: oklch(0.19 0.024 158);
      --lists-ink: oklch(0.91 0.018 105);
      --lists-ink-soft: oklch(0.73 0.02 115);
      --lists-ink-muted: oklch(0.58 0.018 135);
      --lists-line: oklch(0.72 0.055 83 / 0.28);
      --lists-green: oklch(0.67 0.09 150);
      --lists-gold: oklch(0.76 0.105 82);
      --lists-blue: oklch(0.72 0.105 247);
    }
  }
</style>
