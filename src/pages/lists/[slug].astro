---
import { asc, eq } from "drizzle-orm";

import BaseLayout from "@/layouts/BaseLayout.astro";
import CuratedListExperience from "@/components/react/CuratedListExperience";
import { curatedListItems, curatedLists, fics } from "@/db/schema";
import { dbFicToFic } from "@/lib/fic-transform";

const { slug } = Astro.params;
if (!slug) return Astro.redirect("/lists");

const listRows = await Astro.locals.db
  .select()
  .from(curatedLists)
  .where(eq(curatedLists.slug, slug));

if (listRows.length === 0) return new Response(null, { status: 404 });

const list = listRows[0];
const itemRows = await Astro.locals.db
  .select({ item: curatedListItems, fic: fics })
  .from(curatedListItems)
  .innerJoin(fics, eq(curatedListItems.ficId, fics.id))
  .where(eq(curatedListItems.listId, list.id))
  .orderBy(asc(curatedListItems.sortOrder));

const items = itemRows.map((row) => ({
  fic: dbFicToFic(row.fic),
  curatorComment: row.item.curatorComment,
}));
---

<BaseLayout
  title={`${list.title} | Piltover's Finest`}
  description={list.description ?? `${items.length} CaitVi stories from my favorites.`}
  showHeader={false}
  showFooter={false}
>
  <CuratedListExperience
    list={{ title: list.title, description: list.description }}
    items={items}
    client:load
  />
</BaseLayout>

<style is:global>
  .curated-experience {
    --surface: oklch(0.958 0.012 145);
    --surface-raised: oklch(0.985 0.008 110);
    --book-paper: oklch(0.968 0.018 125);
    --ink: oklch(0.26 0.032 238);
    --ink-soft: oklch(0.43 0.025 222);
    --ink-muted: oklch(0.56 0.018 205);
    --line: oklch(0.48 0.035 155 / 0.22);
    --kir-green: oklch(0.39 0.07 153);
    --kir-green-deep: oklch(0.29 0.055 156);
    --kir-green-soft: oklch(0.9 0.035 148);
    --kir-gold: oklch(0.64 0.105 79);
    --kir-gold-soft: oklch(0.82 0.07 82);
    --caitlyn-blue: oklch(0.43 0.095 250);
    --caitlyn-blue-soft: oklch(0.89 0.035 245);
    --vi-red: oklch(0.47 0.16 18);
    --vi-red-soft: oklch(0.9 0.045 18);
    --font-editorial: "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, serif;
    position: relative;
    height: 100svh;
    overflow-x: hidden;
    overflow-y: auto;
    overscroll-behavior-y: contain;
    background: var(--surface);
    color: var(--ink);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    -webkit-font-smoothing: antialiased;
    scrollbar-color: var(--kir-green) transparent;
    scrollbar-width: thin;
  }

  .curated-experience::-webkit-scrollbar {
    width: 7px;
  }

  .curated-experience::-webkit-scrollbar-track {
    background: transparent;
  }

  .curated-experience::-webkit-scrollbar-thumb {
    border: 2px solid var(--surface);
    background: var(--kir-green);
  }

  .curated-experience.is-detail-open {
    overflow: hidden;
  }

  .curated-back {
    position: fixed;
    top: max(1.35rem, env(safe-area-inset-top));
    left: clamp(1.25rem, 4vw, 4rem);
    z-index: 20;
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 0.55rem;
    color: var(--ink-soft);
    font-size: 0.72rem;
    font-weight: 650;
    letter-spacing: 0.045em;
    text-decoration: none;
    text-transform: uppercase;
    transition: color 180ms ease, transform 180ms ease;
  }

  .curated-back span {
    color: var(--kir-gold);
    font-size: 1rem;
  }

  .curated-back:focus-visible,
  .curated-story__button:focus-visible,
  .curated-dialog__close:focus-visible,
  .curated-dialog a:focus-visible {
    outline: 2px solid var(--caitlyn-blue);
    outline-offset: 5px;
  }

  .curated-story__button.is-focus-returned:focus-visible {
    outline: 0;
  }

  .curated-cover {
    min-height: 118svh;
    padding-inline: clamp(1.25rem, 6vw, 6rem);
  }

  .curated-cover__inner {
    position: sticky;
    top: 0;
    display: flex;
    min-height: 100svh;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 13svh clamp(1.5rem, 8vw, 8rem);
    text-align: center;
  }

  .curated-cover__inner::before {
    position: absolute;
    inset: clamp(5.5rem, 12svh, 7.5rem) clamp(0.25rem, 5vw, 5rem);
    border: 1px solid var(--line);
    content: "";
    pointer-events: none;
  }

  .curated-cover__inner::after {
    position: absolute;
    top: clamp(5.25rem, 11.5svh, 7.25rem);
    left: 50%;
    width: 9px;
    height: 9px;
    border: 1px solid var(--kir-gold);
    background: var(--surface);
    content: "";
    pointer-events: none;
    transform: translateX(-50%) rotate(45deg);
  }

  .curated-cover__eyebrow {
    position: relative;
    z-index: 1;
    margin: 0 0 clamp(1.25rem, 3vw, 2.25rem);
    color: var(--kir-green);
    font-size: 0.66rem;
    font-weight: 750;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .curated-cover h1 {
    position: relative;
    z-index: 1;
    max-width: 13ch;
    margin: 0;
    font-family: var(--font-editorial);
    font-size: clamp(3.15rem, 6.5vw, 6rem);
    font-weight: 500;
    line-height: 0.96;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .curated-cover__description {
    position: relative;
    z-index: 1;
    max-width: 38rem;
    margin: clamp(1.75rem, 4vw, 3rem) 0 0;
    color: var(--ink-soft);
    font-family: var(--font-editorial);
    font-size: clamp(1.05rem, 1.7vw, 1.35rem);
    line-height: 1.55;
    text-wrap: pretty;
  }

  .curated-cover__meta {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem 0;
    margin-top: clamp(1.75rem, 4vw, 2.75rem);
    color: var(--ink-soft);
    font-size: 0.68rem;
    font-variant-numeric: tabular-nums;
    font-weight: 650;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .curated-cover__meta span {
    display: inline-flex;
    align-items: center;
  }

  .curated-cover__meta span + span::before {
    width: 1px;
    height: 0.85rem;
    margin-inline: 1rem;
    background: var(--kir-gold);
    content: "";
  }

  .curated-scroll-hint {
    position: absolute;
    bottom: clamp(4.5rem, 10svh, 7rem);
    left: 50%;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    transform: translateX(-50%);
  }

  .curated-scroll-hint span {
    color: var(--vi-red);
    font-size: 0.95rem;
  }

  .curated-sequence {
    position: relative;
  }

  .curated-focus-line {
    position: fixed;
    top: 50%;
    right: 0;
    left: 0;
    z-index: 2;
    opacity: 0;
    pointer-events: none;
    transform: translateY(8px);
    transition: opacity 260ms ease, transform 260ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .curated-focus-line.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .curated-focus-line span {
    position: absolute;
    top: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    background: var(--surface);
    font-size: 0.64rem;
    font-variant-numeric: tabular-nums;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transform: translateY(-50%);
  }

  .curated-focus-line span::before {
    width: 6px;
    height: 6px;
    border: 1px solid var(--kir-gold);
    content: "";
    transform: rotate(45deg);
  }

  .curated-focus-line__count {
    left: clamp(1.25rem, 4vw, 4rem);
    color: var(--kir-green);
  }

  .curated-focus-line__action {
    right: clamp(1.25rem, 4vw, 4rem);
    color: var(--caitlyn-blue);
  }

  .curated-story-list {
    width: 100%;
    max-width: 86rem;
    margin: 0 auto;
    padding: 34svh clamp(1.25rem, 7vw, 7rem) 42svh;
    list-style: none;
  }

  .curated-story {
    position: relative;
    display: grid;
    min-height: clamp(7.75rem, 15svh, 9.5rem);
    place-items: center;
  }

  .curated-focus-marker {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 1px;
    height: 1px;
  }

  .curated-story__button {
    position: relative;
    z-index: 3;
    display: grid;
    width: min(100%, 72rem);
    min-height: 64px;
    grid-template-areas:
      "number title meta"
      "number author meta";
    grid-template-columns: minmax(3.5rem, 0.7fr) minmax(16rem, 3fr) minmax(12rem, 1.35fr);
    align-items: center;
    column-gap: clamp(1rem, 3vw, 3rem);
    border: 0;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    font: inherit;
    padding: 1.25rem 0;
    text-align: center;
  }

  .curated-story__number {
    grid-area: number;
    justify-self: end;
    color: var(--ink-muted);
    font-size: 0.68rem;
    font-variant-numeric: tabular-nums;
    font-weight: 750;
    letter-spacing: 0.12em;
    transition: color 180ms ease;
  }

  .curated-story__title {
    position: relative;
    grid-area: title;
    max-width: 27ch;
    justify-self: center;
    color: var(--ink-muted);
    font-family: var(--font-editorial);
    font-size: clamp(1.55rem, 2.35vw, 2.15rem);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.018em;
    text-wrap: balance;
    transition: color 180ms ease, transform 180ms ease;
  }

  .curated-story__title::before {
    position: absolute;
    top: 50%;
    left: -1.25rem;
    width: 6px;
    height: 6px;
    border: 1px solid transparent;
    content: "";
    opacity: 0;
    transform: translateY(-50%) rotate(45deg);
    transition: border-color 180ms ease, opacity 180ms ease;
  }

  .curated-story__author {
    grid-area: author;
    justify-self: center;
    margin-top: 0.45rem;
    color: var(--ink-muted);
    font-family: var(--font-editorial);
    font-size: 0.9rem;
    font-style: italic;
    transition: color 180ms ease;
  }

  .curated-story__meta {
    grid-area: meta;
    justify-self: start;
    color: var(--ink-muted);
    font-size: 0.68rem;
    font-variant-numeric: tabular-nums;
    font-weight: 650;
    letter-spacing: 0.025em;
    white-space: nowrap;
    transition: color 180ms ease;
  }

  .curated-story__button.is-active .curated-story__number {
    color: var(--kir-gold);
  }

  .curated-story__button.is-active .curated-story__title {
    color: var(--ink);
    transform: scale(1.035);
  }

  .curated-story__button.is-active .curated-story__title::before {
    border-color: var(--kir-green);
    opacity: 1;
  }

  .curated-story__button.is-active .curated-story__author {
    color: var(--caitlyn-blue);
  }

  .curated-story__button.is-active .curated-story__meta {
    color: var(--vi-red);
  }

  .curated-end,
  .curated-empty {
    display: flex;
    min-height: 62svh;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    padding: 4rem 1.25rem;
    text-align: center;
  }

  .curated-end::before,
  .curated-empty::before {
    width: 9px;
    height: 9px;
    border: 1px solid var(--kir-gold);
    content: "";
    transform: rotate(45deg);
  }

  .curated-end p,
  .curated-empty p {
    margin: 0;
    font-family: var(--font-editorial);
    font-size: clamp(1.85rem, 4vw, 3.25rem);
    letter-spacing: -0.025em;
  }

  .curated-end a,
  .curated-empty a {
    min-height: 44px;
    color: var(--caitlyn-blue);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 44px;
    text-transform: uppercase;
  }

  .curated-dialog__overlay {
    position: fixed;
    inset: 0;
    z-index: 80;
    background: oklch(0.16 0.025 220 / 0.66);
  }

  .curated-dialog {
    --surface-raised: oklch(0.985 0.008 110);
    --book-paper: oklch(0.968 0.018 125);
    --ink: oklch(0.26 0.032 238);
    --ink-soft: oklch(0.43 0.025 222);
    --ink-muted: oklch(0.56 0.018 205);
    --line: oklch(0.48 0.035 155 / 0.22);
    --kir-green: oklch(0.39 0.07 153);
    --kir-green-deep: oklch(0.29 0.055 156);
    --kir-green-soft: oklch(0.9 0.035 148);
    --kir-gold: oklch(0.64 0.105 79);
    --caitlyn-blue: oklch(0.43 0.095 250);
    --caitlyn-blue-soft: oklch(0.89 0.035 245);
    --vi-red: oklch(0.47 0.16 18);
    --vi-red-soft: oklch(0.9 0.045 18);
    --font-editorial: "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, serif;
    position: fixed;
    top: 50%;
    left: 50%;
    z-index: 90;
    width: min(64rem, calc(100vw - 3rem));
    max-height: calc(100svh - 3rem);
    color: var(--ink);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    transform: translate(-50%, -50%);
  }

  .curated-dialog__inner {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: minmax(0, 1fr);
    min-height: min(36rem, calc(100svh - 3rem));
    max-height: calc(100svh - 3rem);
    overflow: hidden;
    border: 1px solid var(--kir-gold);
    border-radius: 2px 6px 6px 2px;
    background: var(--kir-green-deep);
    box-shadow: 0 28px 90px oklch(0.13 0.025 220 / 0.46);
    padding: 0.55rem;
  }

  .curated-dialog__inner::before {
    position: absolute;
    top: 0.55rem;
    bottom: 0.55rem;
    left: 50%;
    z-index: 10;
    width: 8px;
    border-inline: 1px solid oklch(0.22 0.04 155 / 0.5);
    background: linear-gradient(
      90deg,
      oklch(0.2 0.04 155 / 0.55),
      oklch(0.5 0.035 100 / 0.18) 48%,
      oklch(0.9 0.025 100 / 0.35) 50%,
      oklch(0.2 0.04 155 / 0.55)
    );
    content: "";
    pointer-events: none;
    transform: translateX(-50%);
  }

  .curated-dialog__close {
    position: absolute;
    top: 1.15rem;
    right: 1.15rem;
    z-index: 20;
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    border: 1px solid var(--kir-gold);
    border-radius: 0;
    background: var(--kir-green-deep);
    color: var(--kir-gold-soft, oklch(0.82 0.07 82));
    cursor: pointer;
    font: inherit;
    transition: background-color 160ms ease, color 160ms ease;
  }

  .curated-dialog__close span {
    font-size: 1.35rem;
    font-weight: 400;
  }

  .curated-dialog__page {
    position: relative;
    min-width: 0;
    min-height: 0;
  }

  .curated-dialog__page--title {
    display: flex;
    min-height: min(34.9rem, calc(100svh - 4.1rem));
    padding: clamp(2.2rem, 4vw, 3.25rem);
    background: var(--book-paper);
    box-shadow: inset -20px 0 32px oklch(0.25 0.03 155 / 0.1);
  }

  .curated-dialog__page--content {
    overflow: hidden;
    background: var(--surface-raised);
    box-shadow: inset 20px 0 32px oklch(0.25 0.03 155 / 0.07);
  }

  .curated-dialog__frame {
    position: absolute;
    inset: 1.1rem;
    border: 1px solid var(--kir-gold);
    pointer-events: none;
  }

  .curated-dialog__frame::before,
  .curated-dialog__frame::after {
    position: absolute;
    left: 50%;
    width: 8px;
    height: 8px;
    border: 1px solid var(--kir-gold);
    background: var(--book-paper);
    content: "";
    transform: translateX(-50%) rotate(45deg);
  }

  .curated-dialog__frame::before {
    top: -5px;
  }

  .curated-dialog__frame::after {
    bottom: -5px;
  }

  .curated-dialog__index {
    position: absolute;
    top: 1.65rem;
    left: 1.65rem;
    color: var(--kir-green);
    font-size: 0.66rem;
    font-variant-numeric: tabular-nums;
    font-weight: 750;
    letter-spacing: 0.08em;
  }

  .curated-dialog__heading {
    position: relative;
    z-index: 2;
    display: flex;
    width: 100%;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 2.5rem 0 0;
    text-align: center;
  }

  .curated-dialog__rating {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin: 0 0 2rem;
    color: var(--kir-green);
    font-size: 0.66rem;
    font-weight: 750;
    letter-spacing: 0.14em;
  }

  .curated-dialog__rating::before,
  .curated-dialog__rating::after {
    width: 1.5rem;
    height: 1px;
    background: var(--kir-gold);
    content: "";
  }

  .curated-dialog__author {
    margin: 1rem 0 0;
    color: var(--caitlyn-blue);
    font-family: var(--font-editorial);
    font-size: 1rem;
    font-style: italic;
  }

  .curated-dialog h2 {
    max-width: 15ch;
    margin: 0;
    font-family: var(--font-editorial);
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .curated-dialog__metadata {
    margin: auto 0 0;
    padding-top: 2.5rem;
    color: var(--ink-soft);
    font-size: 0.68rem;
    font-variant-numeric: tabular-nums;
    font-weight: 650;
    letter-spacing: 0.03em;
  }

  .curated-dialog__body {
    height: 100%;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: clamp(3.75rem, 6vw, 5rem) clamp(1.5rem, 4vw, 3rem) 2.5rem;
    scrollbar-color: var(--kir-green) transparent;
    scrollbar-width: thin;
  }

  .curated-dialog__reading {
    display: grid;
    gap: 2.25rem;
  }

  .curated-dialog h3 {
    margin: 0 0 1rem;
    color: var(--kir-green);
    font-size: 0.66rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .curated-dialog__reading p {
    max-width: 65ch;
    margin: 0;
    font-family: var(--font-editorial);
    font-size: 1.02rem;
    line-height: 1.65;
    text-wrap: pretty;
  }

  .curated-dialog__summary {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 8;
    white-space: pre-line;
  }

  .curated-dialog__curator-note {
    padding-left: 1rem;
    border-left: 2px solid var(--vi-red);
    color: var(--vi-red);
    font-style: italic;
  }

  .curated-dialog blockquote {
    max-width: 26ch;
    margin: 2.5rem 0;
    padding: 0;
    color: var(--ink-soft);
    font-family: var(--font-editorial);
    font-size: 1.02rem;
    font-style: italic;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .curated-dialog__aside {
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
    margin-top: 2.5rem;
    padding-top: 2.25rem;
    border-top: 1px solid var(--line);
  }

  .curated-signal-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .curated-signal-list li {
    border-top: 1px solid var(--line);
    padding: 0.55rem 0;
    color: var(--ink-soft);
    font-size: 0.68rem;
    font-weight: 650;
    text-transform: capitalize;
  }

  .curated-dialog__links {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }

  .curated-dialog__links a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--kir-green);
    border-radius: 0;
    color: var(--kir-green);
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.04em;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
  }

  .curated-dialog__links .curated-dialog__primary-link {
    border-color: var(--caitlyn-blue);
    background: var(--caitlyn-blue);
    color: var(--surface-raised);
  }

  @media (hover: hover) {
    .curated-back:hover {
      color: var(--caitlyn-blue);
      transform: translateX(-3px);
    }

    .curated-story__button:not(.is-active):hover .curated-story__title {
      color: var(--ink-soft);
    }

    .curated-story__button:not(.is-active):hover .curated-story__number {
      color: var(--kir-gold);
    }

    .curated-dialog__links a:hover {
      background: var(--kir-green-soft);
      color: var(--kir-green-deep);
    }

    .curated-dialog__links .curated-dialog__primary-link:hover {
